# Neon Serverless PostgreSQL Database URL (Recommended - 100% Free)
# Copy from your Neon.tech console dashboard
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (Used for signing user sessions)
JWT_SECRET="your-super-secure-jwt-secret-key-2026"

# Server Port (optional, defaults to 5001)
PORT=5001
