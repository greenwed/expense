# Database URL (Neon Serverless PostgreSQL Database)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="rupeetrack-super-secure-jwt-secret-key-2026"

# Email Delivery Configuration (Optional - for sending real OTP & recovery emails)
# Option A: Gmail SMTP (e.g. using Gmail App Password)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# Option B: Standard SMTP (Resend, Brevo, SendGrid, Zoho, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="RupeeTrack <noreply@yourdomain.com>"
