# MongoDB Connection URI (Free M0 sandbox from MongoDB Atlas or any MongoDB server)
# Leave empty or omit to use the built-in persistent zero-setup storage
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/expensetracker?retryWrites=true&w=majority"

# JWT Authentication Secret
JWT_SECRET="your-super-secure-jwt-secret-key-2026"

# Server Port (optional, defaults to 5001)
PORT=5001
